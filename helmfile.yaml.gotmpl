---
bases:
  - bases/helmDefaults.yaml.gotmpl
  - bases/environments.yaml.gotmpl

{{- $foundationsMode := env "FOUNDATIONS_MODE" | default "local" }}
{{- $foundationsRef := env "FOUNDATIONS_REF" | default "v0.2.0" }}
{{- $foundationsRepo := env "FOUNDATIONS_REPO" | default "https://github.com/gdc-iac/gdc-iac-org.git" }}
{{- $foundationsLocalPath := env "FOUNDATIONS_LOCAL_PATH" | default "../gdc-iac-org/foundations" }}

helmfiles:
{{- if eq $foundationsMode "remote" }}
  - path: "git::{{ $foundationsRepo }}//foundations/releases/0-bootstrap/helmfile.yaml.gotmpl?ref={{ $foundationsRef }}"
  - path: "git::{{ $foundationsRepo }}//foundations/releases/0-org-setup/helmfile.yaml.gotmpl?ref={{ $foundationsRef }}"
  - path: "git::{{ $foundationsRepo }}//foundations/releases/1-project-factory/helmfile.yaml.gotmpl?ref={{ $foundationsRef }}"
  - path: "git::{{ $foundationsRepo }}//foundations/releases/2-resources/helmfile.yaml.gotmpl?ref={{ $foundationsRef }}"
  - path: "git::{{ $foundationsRepo }}//foundations/releases/3-clusters/helmfile.yaml.gotmpl?ref={{ $foundationsRef }}"
  - path: "git::{{ $foundationsRepo }}//foundations/releases/4-notebooks/helmfile.yaml.gotmpl?ref={{ $foundationsRef }}"
{{- else }}
  - path: "{{ $foundationsLocalPath }}/releases/0-bootstrap/helmfile.yaml.gotmpl"
  - path: "{{ $foundationsLocalPath }}/releases/0-org-setup/helmfile.yaml.gotmpl"
  - path: "{{ $foundationsLocalPath }}/releases/1-project-factory/helmfile.yaml.gotmpl"
  - path: "{{ $foundationsLocalPath }}/releases/2-resources/helmfile.yaml.gotmpl"
  - path: "{{ $foundationsLocalPath }}/releases/3-clusters/helmfile.yaml.gotmpl"
  - path: "{{ $foundationsLocalPath }}/releases/4-notebooks/helmfile.yaml.gotmpl"
{{- end }}

missingFileHandler: Error
